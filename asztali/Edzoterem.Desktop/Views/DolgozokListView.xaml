<UserControl x:Class="Edzoterem.Desktop.Views.DolgozokListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dolgozók" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#D3D1C7" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Vezetéknév"/>
                    <TextBox Text="{Binding UjVezeteknev, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Keresztnév"/>
                    <TextBox Text="{Binding UjKeresztnev, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,0">
                    <TextBlock Text="E-mail"/>
                    <TextBox Text="{Binding UjEmail, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="100" Margin="0,0,8,0">
                    <TextBlock Text="Nem"/>
                    <ComboBox ItemsSource="{Binding NemOpciok}" SelectedItem="{Binding UjNem}"/>
                </StackPanel>
                <StackPanel Width="130" Margin="0,0,8,0">
                    <TextBlock Text="Születési dátum"/>
                    <DatePicker SelectedDate="{Binding UjSzuletesiDatum}"/>
                </StackPanel>
                <Button Content="Felvétel" VerticalAlignment="Bottom" Padding="8,4"
                        Command="{Binding UjDolgozoFelveteleCommand}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Dolgozok}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vezetéknév" Binding="{Binding Vezeteknev}"/>
                <DataGridTextColumn Header="Keresztnév" Binding="{Binding Keresztnev}"/>
                <DataGridTextColumn Header="Munkakör" Binding="{Binding Munkakor}"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Aktív" Binding="{Binding Aktiv}"/>
                <DataGridTemplateColumn Header="Művelet">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Kiléptetés" Padding="6,2"
                                    Command="{Binding DataContext.KileptetesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Foreground="Red" Text="{Binding HibaUzenet}"/>
    </Grid>
</UserControl>
