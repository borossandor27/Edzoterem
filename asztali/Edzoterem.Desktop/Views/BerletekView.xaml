<UserControl x:Class="Edzoterem.Desktop.Views.BerletekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bérletek" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="#D3D1C7" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Bérlet hozzárendelése taghoz" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="200" Margin="0,0,8,0">
                        <TextBlock Text="Tag"/>
                        <ComboBox ItemsSource="{Binding Tagok}" SelectedItem="{Binding KivalasztottTag}"
                                  DisplayMemberPath="Keresztnev"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,8,0">
                        <TextBlock Text="Bérlettípus"/>
                        <ComboBox ItemsSource="{Binding Tipusok}" SelectedItem="{Binding KivalasztottTipus}"
                                  DisplayMemberPath="Nev"/>
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,8,0">
                        <TextBlock Text="Kezdő dátum"/>
                        <DatePicker SelectedDate="{Binding KezdoDatum}"/>
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,8,0">
                        <TextBlock Text="Lejárati dátum"/>
                        <DatePicker SelectedDate="{Binding LejaratiDatum}"/>
                    </StackPanel>
                    <Button Content="Hozzárendelés" VerticalAlignment="Bottom" Padding="8,4"
                            Command="{Binding HozzarendelesCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding SikerUzenet}" Foreground="Green" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding HibaUzenet}" Foreground="Red" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Lejáró/lejárt bérletek" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding LejaroBerletek}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tag" Binding="{Binding TagNev}"/>
                <DataGridTextColumn Header="Bérlettípus" Binding="{Binding BerletTipusNev}"/>
                <DataGridTextColumn Header="Lejárat" Binding="{Binding LejaratiDatum}"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding Statusz}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
