<UserControl x:Class="Edzoterem.Desktop.Views.CsoportosFoglalkozasokView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Csoportos foglalkozások" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Foglalkozasok}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectedItem="{Binding KivalasztottFoglalkozas}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Megnevezés" Binding="{Binding Megnevezes}"/>
                <DataGridTextColumn Header="Edző" Binding="{Binding EdzoNev}"/>
                <DataGridTextColumn Header="Időpont" Binding="{Binding Idopont}"/>
                <DataGridTextColumn Header="Helyszín" Binding="{Binding Helyszin}"/>
                <DataGridTextColumn Header="Max. létszám" Binding="{Binding MaxLetszam}"/>
                <DataGridTextColumn Header="Jelentkezők" Binding="{Binding Jelentkezesek.Count}"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding Statusz}"/>
                <DataGridTemplateColumn Header="Jóváhagyás">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Jóváhagyás" Margin="2" Padding="6,2"
                                        Command="{Binding DataContext.JovahagyasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"/>
                                <Button Content="Elutasítás" Margin="2" Padding="6,2"
                                        Command="{Binding DataContext.ElutasitasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderBrush="#D3D1C7" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Tag jelentkeztetése a kiválasztott (jóváhagyott) foglalkozásra" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="220" Margin="0,0,8,0">
                        <TextBlock Text="Tag"/>
                        <ComboBox ItemsSource="{Binding Tagok}" SelectedItem="{Binding KivalasztottTag}"
                                  DisplayMemberPath="Keresztnev"/>
                    </StackPanel>
                    <Button Content="Jelentkeztetés" VerticalAlignment="Bottom" Padding="8,4"
                            Command="{Binding JelentkezesCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Width="300" Margin="0,0,8,0">
                        <TextBlock Text="Elutasítás indoka (elutasításhoz)"/>
                        <TextBox Text="{Binding ElutasitasIndoka, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding HibaUzenet}" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
