<Window x:Class="Edzoterem.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edzőterem – Bejelentkezés" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edzőterem – asztali alkalmazás" FontSize="18" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="Felhasználónév"/>
        <TextBox Grid.Row="3" x:Name="FelhasznalonevBox" Text="{Binding Felhasznalonev, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="Jelszó"/>
        <PasswordBox Grid.Row="5" x:Name="JelszoBox"/>

        <Button Grid.Row="6" Content="Bejelentkezés" Padding="8,4" HorizontalAlignment="Left"
                Command="{Binding BejelentkezesCommand}" CommandParameter="{Binding ElementName=JelszoBox, Path=Password}"
                IsEnabled="{Binding Folyamatban, Converter={StaticResource InverseBooleanConverter}}"/>

        <TextBlock Grid.Row="8" Text="{Binding HibaUzenet}" Foreground="Red" TextWrapping="Wrap"/>
    </Grid>
</Window>
